# Copie este arquivo para .env e preencha os valores.
# Nunca versione o .env nem o frontend/.env.local.

# ----------------------------------------------------------------------
# Banco de Dados
# ----------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=local_password_123
DB_NAME=pwa_db

# ----------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------
# URL pública exposta ao navegador (Client-side Fetching)
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL interna para comunicação dentro da rede Docker (Server-side Fetching)
INTERNAL_API_URL=http://backend-core:8080

# ----------------------------------------------------------------------
# Google Maps
# ----------------------------------------------------------------------
# Chave usada pelo backend-core (Directions API e Places API).
# Fica só no servidor: restrinja por API (e por IP, se possível) no Google Cloud Console.
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Chave do mapa no navegador (Maps JavaScript API), usada pelo frontend.
# Ela fica VISÍVEL no cliente (prefixo NEXT_PUBLIC_), então use uma chave DIFERENTE
# da de cima e restrinja por domínio/referrer (ex.: localhost:3000/* em dev).
# O Next.js lê esta variável de frontend/.env.local (copie esta linha para lá).
# Gerada em https://console.cloud.google.com/google/maps-apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_publica_google_maps_aqui

# ----------------------------------------------------------------------
# Privacidade (LGPD)
# ----------------------------------------------------------------------
# E-mail exibido na política de privacidade (/privacidade) para pedidos que a página
# Minha conta não resolve, como trocar o e-mail. Opcional: sem ele, a página orienta a
# procurar a equipe do projeto. Use um e-mail do projeto, não um pessoal.
NEXT_PUBLIC_CONTATO_PRIVACIDADE=

# ----------------------------------------------------------------------
# IA Service (curadoria dos roteiros)
# ----------------------------------------------------------------------
# Cadeia de fallback: Claude -> Gemini -> OpenAI -> Mistral local (Ollama, só em dev) -> sem curadoria.
# Cada chave é opcional: o provedor sem chave simplesmente sai da cadeia.

# Claude — console.anthropic.com (pago)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini — aistudio.google.com/app/apikey (tier grátis sem cartão, ~1.500 req/dia no plano gratuito)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI — platform.openai.com (pago)
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Timeout em segundos aplicado a cada provedor comercial da cadeia (padrão: 15). O Mistral local tem limite próprio de 30 s.
LLM_TIMEOUT_SECONDS=15

# Limite de tokens da resposta de cada provedor (padrão: 4096)
LLM_MAX_TOKENS=4096

# Tempo total da cadeia de provedores, em segundos (padrão: 35). Fica abaixo de IA_SERVICE_TIMEOUT_SECONDS.
LLM_ORCAMENTO_TOTAL_SECONDS=35

# Mistral local pelo Ollama, só em desenvolvimento e por último na cadeia. Desligado por padrão.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Endereço do ia-service visto pelo backend-core.
# No Docker Compose o valor já é fixado em http://ia-service:8000 (rede interna);
# esta variável vale para rodar o backend-core fora do Docker.
IA_SERVICE_URL=http://localhost:8000

# Tempo máximo (s) que o backend-core espera pela curadoria antes de devolver o roteiro sem ela (padrão: 40)
IA_SERVICE_TIMEOUT_SECONDS=40

# Segredo compartilhado entre o backend-core e o ia-service (cabeçalho X-Kyr-Token).
# Com ele definido nos dois, o /curar-roteiro recusa chamadas de fora. Obrigatório se o ia-service tiver
# endereço público. Gere um valor aleatório longo, por exemplo: openssl rand -hex 32
IA_SERVICE_TOKEN=

# ----------------------------------------------------------------------
# Limites de uso e IP do cliente
# ----------------------------------------------------------------------
# Cada roteiro faz até 8 buscas no Places e 2 consultas de rota (cobradas pelo Google) e uma chamada à IA.
# Limites do POST /roteiros e do GET /api/v1/rotas/pois. 0 desliga.
ROTEIRO_LIMITE_POR_IP_POR_HORA=10
ROTEIRO_LIMITE_POR_DIA=30

# Segredo compartilhado entre o servidor do Next e o backend-core. Com ele, o Next informa o IP do
# navegador ao backend (X-Kyr-Client-Ip), usado nos limites de login, cadastro e roteiros.
# Defina o mesmo valor no frontend e no backend-core. Gere com: openssl rand -hex 32
KYR_PROXY_TOKEN=

# Quantos proxies confiáveis ficam na frente do serviço e acrescentam o IP ao X-Forwarded-For
# (por exemplo, 1 atrás do balanceador da hospedagem). 0: o X-Forwarded-For é ignorado.
# Vale para o frontend e para o backend-core; confira o valor no provedor de hospedagem.
KYR_PROXIES_CONFIAVEIS=0

# ----------------------------------------------------------------------
# Backend-core: outros ajustes (opcionais)
# ----------------------------------------------------------------------
# Quantidade máxima de POIs (os de maior nota) enviados à curadoria (padrão: 10)
ROTEIRO_MAX_POIS_CURADORIA=10
# Por quantos dias a curadoria de um lugar é reaproveitada (padrão: 30)
ROTEIRO_CACHE_CURADORIA_DIAS=30
# Prazo de leitura das chamadas ao Google, em segundos (padrão: 10)
GOOGLE_MAPS_TIMEOUT_SECONDS=10

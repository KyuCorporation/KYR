# Banco de Dados
DB_USER=postgres
DB_PASSWORD=local_password_123
DB_NAME=pwa_db

# Frontend
# URL pública exposta ao navegador (Client-side Fetching)
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL interna para comunicação dentro da rede Docker (Server-side Fetching)
INTERNAL_API_URL=http://backend-core:8080

# Serviços Externos
# Chave de API do provedor de LLM para a curadoria dos roteiros
LLM_API_KEY=sua_chave_api_llm_aqui

# Chave de API do Google Maps para geolocalização e cenários reais
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Chave de API do Google Maps para o mapa no navegador (US-20).
# Precisa do prefixo NEXT_PUBLIC_ para ficar visível no cliente.
# Gerada em https://console.cloud.google.com/google/maps-apis/credentials,
# habilitando a "Maps JavaScript API" e restringindo por domínio/referrer
# (ex: localhost:3000/* em dev, e o domínio de produção depois).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_publica_google_maps_aqui
# Etapa 1: Build (Compilação)
FROM maven:3.9.6-eclipse-temurin-21-alpine AS builder
WORKDIR /app

# Copia apenas o pom.xml primeiro para otimizar o cache do Docker
COPY pom.xml .
RUN mvn dependency:go-offline

# Copia o código-fonte e compila o .jar (pulando os testes no build da imagem)
COPY src ./src
RUN mvn clean package -DskipTests

# Etapa 2: Runner (Produção)
FROM eclipse-temurin:21-jre-alpine AS runner
WORKDIR /app

# Criação de um usuário não-root para maior segurança do contêiner
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

# Copia exclusivamente o .jar gerado na Etapa 1 para a imagem final
COPY --from=builder /app/target/*.jar app.jar

EXPOSE 8080

# Ponto de entrada direto executando o binário Java
ENTRYPOINT ["java", "-jar", "app.jar"]